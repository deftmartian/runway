Categories:
  - Sports & Health
License: AGPL-3.0-only
AuthorName: runway contributors
SourceCode: https://github.com/deftmartian/runway
IssueTracker: https://github.com/deftmartian/runway/issues
# The repository index key is separate from the APK key. This app's APK must be
# signed with the canonical dev.deftmartian.runway release certificate so it can
# update installations from GitHub releases. After the first controlled publish,
# pin that canonical APK signer here:
# AllowedAPKSigningKeys: REPLACE_WITH_LOWERCASE_CERT_SHA256_WITHOUT_COLONS

RepoType: git
Repo: https://github.com/deftmartian/runway.git

# Copy this metadata into the operator-owned personal F-Droid repository. Update
# these three values together for every release; the tag must match the source
# and the version code must remain monotonic.
Builds:
  - versionName: 0.8.9
    versionCode: 23
    commit: v0.8.9
    subdir: android
    gradle:
      - yes
    gradleprops:
      - runwayFdroidSourceBuild=true

AutoUpdateMode: None
UpdateCheckMode: None
